{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "0.1.18",
  "identifier": "com.aether.desktop",
  "build": {
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:",
      "capabilities": [
        "desktop-local",
        "desktop-dashboard"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "个人 AI API 网关",
    "longDescription": "本机运行的 Aether 网关，包含渠道、API Key、路由与用量管理。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/aether-gateway"
    ],
    "resources": {
      "../../../frontend/dist/": "web/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist"
    }
  }
}
