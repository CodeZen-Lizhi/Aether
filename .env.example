# ==================== Aether 个人版环境变量示例 ====================

# 应用端口（默认 8084）
APP_PORT=8084

# 数据库：SQLite（默认，数据落在 ./data/aether.db）
AETHER_DATABASE_DRIVER=sqlite
AETHER_DATABASE_URL=sqlite:///opt/aether/data/aether.db

# 运行时状态后端：memory（单机固定；无 Redis/Postgres）
AETHER_RUNTIME_BACKEND=memory

# 日志
RUST_LOG=aether_gateway=info
AETHER_LOG_DESTINATION=stdout
AETHER_LOG_FORMAT=pretty

# API Key 前缀（默认 sk）
API_KEY_PREFIX=sk

# JWT 密钥（使用 ./generate_keys.sh 生成；更换后所有用户需重新登录）
JWT_SECRET_KEY=change-this-to-a-secure-random-string

# 加密密钥（加密 Provider API Key 等敏感数据；更换后需重新配置所有渠道密钥）
ENCRYPTION_KEY=change-this-to-another-secure-random-string

# 启动自举管理员（仅在数据库中还没有管理员时生效）
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# CORS（跨域带 Cookie 时不要写 *，显式列出前端源）
# CORS_ORIGINS=http://localhost:5173
# CORS_ALLOW_CREDENTIALS=true
